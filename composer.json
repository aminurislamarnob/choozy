{
    "name": "welabs/choozy",
    "description": "Easily enhance your WooCommerce cart experience with Selective Checkout for WooCommerce. This plugin allows customers to selectively choose which items in their cart they want to purchase using a simple checkbox interface. Only the checked items will proceed to checkout, while the rest remain in the cart for future purchases.",
    "license": "GPL2",
    "autoload": {
        "psr-4": {
            "WeLabs\\Choozy\\": "includes/"
        }
    },
    "authors": [
        {
            "name": "Aminur Islam",
            "email": "eng.aminurislam@gmail.com",
            "homepage": "https://wordpress.org/plugins/choozy/"
        }
    ],
    "minimum-stability": "dev",
    "require-dev": {
        "wp-coding-standards/wpcs": "dev-develop",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2",
        "tareq1988/wp-php-cs-fixer": "dev-master",
        "phpcompatibility/phpcompatibility-wp": "dev-master",
        "phpunit/phpunit": "~8.5",
        "wp-phpunit/wp-phpunit": "^6.1",
        "yoast/phpunit-polyfills": "^1.0",
        "symfony/var-dumper": "^5.4"
    },
   "scripts": {
        "phpcs": [
            "vendor/bin/phpcs -p -s"
        ],
        "phpcs:report": [
            "vendor/bin/phpcs --report-file='phpcs-report.txt'"
        ],
        "phpcbf": [
            "vendor/bin/phpcbf -p"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
